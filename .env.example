# SSH MCP Server Environment Configuration
# Copy this to .env and fill in your values

# ===========================================
# OPTION 1: Multiple Named Connections
# ===========================================
# List connection names (comma-separated):
SSH_CONNECTIONS=server1,server2

# For each connection, use prefix SSH_<NAME>_
# Required: HOST, USERNAME, and either PASSWORD or PRIVATE_KEY
SSH_SERVER1_HOST=192.168.1.10
SSH_SERVER1_PORT=22
SSH_SERVER1_USERNAME=user
SSH_SERVER1_PASSWORD=secret
# SSH_SERVER1_PRIVATE_KEY=/path/to/key
# SSH_SERVER1_PASSPHRASE=keypass
# SSH_SERVER1_WHITELIST=^ls,^cat,^pwd
# SSH_SERVER1_BLACKLIST=^rm -rf,^shutdown
# SSH_SERVER1_SOCKS_PROXY=socks://proxy:1080
# SSH_SERVER1_TIMEOUT=30000

SSH_SERVER2_HOST=192.168.1.11
SSH_SERVER2_PORT=22
SSH_SERVER2_USERNAME=admin
SSH_SERVER2_PASSWORD=secret

# ===========================================
# OPTION 2: Single Default Connection
# ===========================================
# If SSH_CONNECTIONS is not set, these are used for a "default" connection:
# SSH_HOST=192.168.1.1
# SSH_PORT=22
# SSH_USERNAME=user
# SSH_PASSWORD=secret
# SSH_PRIVATE_KEY=/path/to/id_rsa
# SSH_PASSPHRASE=keypass
# SSH_WHITELIST=^ls,^cat
# SSH_BLACKLIST=^rm,^shutdown
# SSH_SOCKS_PROXY=socks://proxy:1080
# SSH_TIMEOUT=30000
